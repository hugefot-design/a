# AnbudRadar – konfigurasjon. Kopier til .env (lokalt) eller sett som miljøvariabler hos verten.
# Hemmeligheter leses bare på serveren og sendes aldri til nettleseren.
# Verdiene under fungerer for lokal utvikling. I produksjon MÅ alle merket [PROD] settes.

# --- Generelt ---------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=3000
APP_URL=http://localhost:3000        # [PROD] https://din-domene.no – brukes i lenker, e-post og CSRF-sjekk
TRUST_PROXY=false                    # true bak Render/Fly/Cloudflare, slik at riktig klient-IP brukes i rate limiting

# --- Database (PostgreSQL) ---------------------------------------------------
# Webappen: rollen anbudradar_app (underlagt radnivåsikkerhet)
DATABASE_URL=postgres://anbudradar_app:anbudradar_app_dev@127.0.0.1:5432/anbudradar_dev
# Migreringer og bakgrunnsjobber: eier-rollen (i Supabase: postgres)
DATABASE_ADMIN_URL=postgres://anbudradar_owner:anbudradar_owner_dev@127.0.0.1:5432/anbudradar_dev
DATABASE_SSL=disable                 # [PROD] require
DATABASE_POOL_SIZE=10
# DATABASE_PREPARE=false             # sett hvis du bruker en pooler i transaksjonsmodus (Supabase port 6543)

# --- Sikkerhet ---------------------------------------------------------------
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789   # [PROD] minst 32 tilfeldige tegn: openssl rand -hex 32
CRON_SECRET=dev-cron-secret          # [PROD] tilfeldig – kreves for POST /api/cron/:oppgave

# --- AI ----------------------------------------------------------------------
# none (AI av) | openai | anthropic | mock (simulerte svar – kun utvikling/test, nektes i produksjon)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=                        # modell som støtter strukturerte svar (json_schema)
OPENAI_MODEL_FAST=                   # valgfri billig modell for sammendrag/ukesoversikt (tom = OPENAI_MODEL)
ANTHROPIC_API_KEY=                   # [PROD] settes som hemmelig variabel hos verten – aldri i koden
ANTHROPIC_MODEL=                     # kvalitetsmodell (analyse, egnethet, lønnsomhet, tilbudstekst), f.eks. claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=                # valgfri billig modell for sammendrag/ukesoversikt, f.eks. claude-haiku-5-5 (tom = ANTHROPIC_MODEL)
ANTHROPIC_API_BASE_URL=https://api.anthropic.com   # låst eksplisitt, slik at en annen ANTHROPIC_BASE_URL i miljøet ikke brukes
# Priser i USD per million tokens – brukes til kostnadssporing i admin.
# 0 = innebygd prisliste for kjente modeller (src/domain/ai/provider.ts). Sett egne tall for andre modeller.
AI_INPUT_PRICE_PER_MTOK_USD=0
AI_OUTPUT_PRICE_PER_MTOK_USD=0
AI_FAST_INPUT_PRICE_PER_MTOK_USD=0
AI_FAST_OUTPUT_PRICE_PER_MTOK_USD=0
AI_MONTHLY_COST_LIMIT_USD_PER_ORG=0  # tak på AI-kostnad per organisasjon per måned (USD), 0 = bare kvotene i planen
AI_MAX_INPUT_CHARS=120000            # tak på kildetekst per analyse (styrer kostnad)
AI_TIMEOUT_MS=90000

# --- E-post ------------------------------------------------------------------
EMAIL_PROVIDER=log                   # log (skrives til logg/admin, sendes ikke) | resend [PROD]
RESEND_API_KEY=
EMAIL_FROM=AnbudRadar <varsler@example.com>   # [PROD] adresse på et domene verifisert hos Resend
EMAIL_REPLY_TO=                      # valgfri svaradresse (f.eks. kundeservice) – ellers svarer folk til avsender
ADMIN_NOTIFICATION_EMAIL=            # mottar kontaktskjema og feilrapporter

# --- Stripe (betaling) ---------------------------------------------------------
# Uten disse vises abonnementssiden, men betaling er slått av. Bruk sk_test_… til testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=               # whsec_… fra webhook-endepunktet /api/webhooks/stripe
STRIPE_PRICE_STARTER=                # price_… (199 kr/mnd)
STRIPE_PRICE_PROFESSIONAL=           # price_… (499 kr/mnd)
STRIPE_PRICE_BUSINESS=               # price_… (999 kr/mnd)
STRIPE_TAX_RATE_ID=                  # valgfri fast avgiftssats txr_… (25 % MVA) – avklar med regnskapsfører
STRIPE_AUTOMATIC_TAX=false           # true = Stripe Tax (koster ekstra per transaksjon); bruk enten denne eller STRIPE_TAX_RATE_ID

# --- Fillagring (opplastede dokumenter) ---------------------------------------
STORAGE_DRIVER=local                 # local | supabase [PROD anbefalt – lokal disk forsvinner ved ny deploy hos mange verter]
STORAGE_LOCAL_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=           # kun på serveren – gir full tilgang til lagringen
SUPABASE_STORAGE_BUCKET=anbudradar   # PRIVAT bøtte
MAX_UPLOAD_MB=25

# --- Datakilder --------------------------------------------------------------
TED_API_BASE_URL=https://api.ted.europa.eu
DOFFIN_API_BASE_URL=https://api.doffin.no/public/v2
DOFFIN_API_KEY=                      # abonnementsnøkkel fra Doffins API-portal
DOFFIN_ENRICH_XML=false              # hent full eForms-XML for nye Doffin-treff (sett true etter live-test av --id)
DOFFIN_ENRICH_INTERVAL_MINUTES=10    # hvor ofte arbeideren beriker (minst 5)
DOFFIN_ENRICH_MAX_PER_RUN=25         # nedlastinger per kjøring (1–60; 6,5 s mellom hver)
RUN_WORKER_IN_WEB=false              # true = bakgrunnsjobbene kjører i nettsiden (gratisoppsett uten egen arbeider)
INGEST_INTERVAL_MINUTES=120          # hvor ofte arbeideren henter (minst 15)
INGEST_LOOKBACK_DAYS=14              # første henting går så langt tilbake

# --- Forretning og juridisk -----------------------------------------------------
TRIAL_DAYS=14
LEGAL_PAGES_REVIEWED=false           # sett true først når personvern og vilkår er gjennomgått av jurist
COMPANY_LEGAL_NAME=[Selskapsnavn AS]
COMPANY_ORG_NUMBER=[org.nr.]
COMPANY_ADDRESS=[adresse]
COMPANY_CONTACT_EMAIL=kontakt@example.com
