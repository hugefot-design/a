{
  "name": "anbudradar",
  "version": "0.1.0",
  "private": true,
  "description": "AnbudRadar – AI-støttet innsikt i offentlige anskaffelser for norske bedrifter",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "db:setup-local": "bash scripts/setup-local-db.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-dev": "tsx scripts/seed-dev.ts",
    "db:reset-dev": "tsx scripts/migrate.ts --reset && tsx scripts/seed-dev.ts",
    "ingest": "tsx scripts/ingest.ts",
    "import:file": "tsx scripts/import-file.ts",
    "import:cpv": "tsx scripts/import-cpv.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test node --import tsx --test --test-reporter=spec tests/unit/*.test.ts",
    "test:integration": "NODE_ENV=test tsx scripts/prepare-test-db.ts && NODE_ENV=test node --import tsx --test --test-concurrency=1 --test-reporter=spec tests/integration/*.test.ts",
    "test:e2e": "NODE_ENV=test tsx scripts/prepare-test-db.ts && NODE_ENV=test node --import tsx --test --test-concurrency=1 --test-reporter=spec tests/e2e/*.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "docx": "9.8.1",
    "jszip": "3.10.1",
    "pdfjs-dist": "6.2.108",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
